# Copiar a .env (ignorado por git).
#
# Para `npm run dev`: URL del backend en desarrollo local.
# Para `docker compose build` (ver docker-compose.yml): tiene que ser la URL
# PUBLICA real de servidor-estacionamiento, no localhost — Vite la resuelve
# en build time (queda horneada en el JS servido), asi que un valor
# incorrecto solo se corrige reconstruyendo la imagen, no reiniciandola.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Puerto del host donde queda expuesto nginx al levantar con docker compose
# (adentro del contenedor siempre es el 80). Opcional, default 8081.
UI_WEB_PORT=8081
